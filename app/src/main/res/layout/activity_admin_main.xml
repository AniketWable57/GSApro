<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/admin_main_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".admin.admin_main">

   <!-- Main content area -->
   <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="match_parent"
       android:orientation="vertical">

      <!-- Toolbar -->
      <androidx.appcompat.widget.Toolbar
          android:id="@+id/admin_toolbar"
          android:layout_width="match_parent"
          android:layout_height="?attr/actionBarSize"
          android:background="?attr/colorAccent"
          app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
          app:title="Admin Dashboard"
          android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

      <!-- Main content frame -->
      <FrameLayout
          android:id="@+id/admin_content_frame"
          android:layout_width="match_parent"
          android:layout_height="match_parent">

         <!-- Welcome message -->
         <TextView
             android:id="@+id/admin_welcome_text"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:text="Welcome to the Grampanchayat App to control the Gramsevak and other things"
             android:layout_gravity="center"
             android:textSize="18sp"
             android:textColor="@color/black"
             android:padding="16dp"
             android:textAlignment="center" />
      </FrameLayout>
   </LinearLayout>

   <!-- Navigation View for Drawer -->
   <com.google.android.material.navigation.NavigationView
       android:id="@+id/navigationView"
       android:layout_width="wrap_content"
       android:layout_height="match_parent"
       android:layout_gravity="start"
       app:headerLayout="@layout/admin_drawer_header"
       app:menu="@menu/admin_drawer_items" />
</androidx.drawerlayout.widget.DrawerLayout>
