<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ComplaintsActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Title TextView -->
        <TextView
            android:id="@+id/textViewComplaints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="35dp"
            android:text="Complaints"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Add Complaint Button -->
        <ImageView
            android:id="@+id/imageViewAddComplaint"
            android:layout_width="41dp"
            android:layout_height="41dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_add" />

        <!-- RecyclerView for displaying complaints -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewComplaints"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/textViewComplaints"
            android:layout_marginTop="16dp"
            android:padding="8dp" />

    </RelativeLayout>



</androidx.constraintlayout.widget.ConstraintLayout>